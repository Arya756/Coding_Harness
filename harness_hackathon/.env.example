# Primary API key (checked first)
AI_API_KEY=

# Secondary / tertiary fallbacks
HARNESS_LLM_API_KEY=
OPENAI_API_KEY=

# Provider selection: openai | openrouter | ollama | groq | deepseek | qwen | gemini | cursor | generic
HARNESS_LLM_PROVIDER=openai

# Model name
HARNESS_LLM_MODEL=gpt-4o-mini

# Custom OpenAI-compatible base URL (generic/cursor providers)
HARNESS_LLM_BASE_URL=

# Ollama host
HARNESS_LLM_HOST=http://localhost:11434

# Groq base URL override
HARNESS_LLM_GROQ_BASE=https://api.groq.com/openai/v1

# Optional issue text (alternative to --issue / repo/issue.txt)
ISSUE=

# Wall-clock session cap in seconds
HARNESS_MAX_SESSION_SECONDS=1800
